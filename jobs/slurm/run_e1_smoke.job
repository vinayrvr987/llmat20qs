#!/bin/bash
#SBATCH --job-name=20q-e1-smoke
#SBATCH --output=logs/%x-%j.out
#SBATCH --error=logs/%x-%j.err
#SBATCH --time=00-01:00
#SBATCH --mem=16000
#SBATCH --cpus-per-task=4
#SBATCH --exclude=tesla1,tesla2,h100,orion
#SBATCH --gres=gpu:2

set -euo pipefail
cd "$SLURM_SUBMIT_DIR"

module load pytorch-cuda12
source "$HOME/.venvs/llmat20qs/bin/activate"

mkdir -p logs data/raw/results reports
echo "E1 model smoke test started on $(hostname) at $(date)"
nvidia-smi
python -c 'import torch; count = torch.cuda.device_count(); assert count >= 2, f"Smoke test requires 2 GPUs; Slurm exposed {count}"; print(torch.cuda.get_device_name(0)); print(torch.cuda.get_device_name(1))'

GPU_LOG="logs/gpu_usage-${SLURM_JOB_ID}.csv"
echo "timestamp,gpu_index,utilization_percent,memory_used_MB,memory_total_MB" > "$GPU_LOG"
(
    while true; do
        nvidia-smi --query-gpu=timestamp,index,utilization.gpu,memory.used,memory.total \
            --format=csv,noheader,nounits >> "$GPU_LOG"
        sleep 60
    done
) &
GPU_MONITOR_PID=$!
trap 'kill "$GPU_MONITOR_PID" 2>/dev/null || true' EXIT

python -m src.experiments.e1 --smoke-models
echo "E1 model smoke test finished at $(date)"
